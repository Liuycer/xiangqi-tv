[Unit]
Description=Xiangqi TV SQLite online backup
After=xiangqi-engine-api.service

[Service]
Type=oneshot
User=xiangqi
Group=xiangqi
WorkingDirectory=/opt/xiangqi-api
EnvironmentFile=/etc/xiangqi-engine-api.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/xiangqi-api/.venv/bin/python /opt/xiangqi-api/scripts/backup-database.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# SQLite 的只读 WAL 连接仍可能需要创建/访问 -shm 辅助文件；脚本自身通过
# mode=ro 与 PRAGMA query_only 保证不会修改主数据库。
ReadWritePaths=/var/lib/xiangqi-api /var/backups/xiangqi-api
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
